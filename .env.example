# Set to prod only after replacing fake providers below.
EBRAG_PROJECT__ENVIRONMENT=dev
EBRAG_DATABASE__URL=postgresql+psycopg://ebrag:ebrag@localhost:5432/ebrag
# Supported: fake, openai, anthropic, google. Production must not use fake.
EBRAG_LLM__PROVIDER=fake
EBRAG_LLM__API_KEY=
EBRAG_LLM__MODEL=gpt-4o-mini
EBRAG_LLM__BASE_URL=https://api.openai.com/v1
EBRAG_LLM__TIMEOUT_SECONDS=60
EBRAG_LLM__MAX_RETRIES=2
# Supported: fake, sentence_transformers. Production must not use fake.
EBRAG_EMBEDDING__PROVIDER=fake
EBRAG_EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
EBRAG_VECTOR__COLLECTION=evidence_spans
EBRAG_RERANKER__PROVIDER=simple
EBRAG_STORAGE__OBJECT_STORE=minio
EBRAG_STORAGE__RAW_BUCKET=raw-documents
EBRAG_STORAGE__PARSED_BUCKET=parsed-documents
EBRAG_STORAGE__PAGE_IMAGE_BUCKET=page-images
EBRAG_STORAGE__MINIO_ACCESS_KEY=minio
EBRAG_STORAGE__MINIO_SECRET_KEY=minio123
EBRAG_STORAGE__MINIO_SECURE=false
EBRAG_STORAGE__LOCAL_ROOT=.local-object-store
EBRAG_SERVICES__OPENSEARCH_URL=http://localhost:9200
EBRAG_SERVICES__QDRANT_URL=http://localhost:6333
EBRAG_SERVICES__NEO4J_URL=bolt://localhost:7687
EBRAG_SERVICES__MINIO_ENDPOINT=localhost:9000
EBRAG_SERVICES__REDIS_URL=redis://localhost:6379/0
EBRAG_SERVICES__GROBID_URL=http://localhost:8070
