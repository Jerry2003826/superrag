# Copy this file to .env and replace every "replace-with-..." value before Docker startup.

EBRAG_PROJECT__ENVIRONMENT=dev

# Docker Compose service credentials
POSTGRES_DB=ebrag
POSTGRES_USER=ebrag_app
POSTGRES_PASSWORD=replace-with-strong-db-secret
MINIO_ROOT_USER=ebrag_minio
MINIO_ROOT_PASSWORD=replace-with-strong-minio-secret
NEO4J_AUTH=neo4j/replace-with-strong-neo4j-secret

# Browser/API access guard. This is not the LLM provider key.
EBRAG_SECURITY__API_KEY=replace-with-random-api-key
EBRAG_SECURITY__CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
EBRAG_SECURITY__RATE_LIMIT_DEFAULT=120/minute
EBRAG_SECURITY__RATE_LIMIT_QUERY=30/minute
EBRAG_SECURITY__RATE_LIMIT_INGESTION=10/minute
EBRAG_SECURITY__RATE_LIMIT_ADMIN=5/hour
EBRAG_SECURITY__UPLOAD_MAX_BYTES=52428800

# Optional direct host run; Docker Compose injects its own in-network URL.
EBRAG_DATABASE__URL=postgresql+psycopg://ebrag_app:replace-with-strong-db-secret@localhost:5432/ebrag

# Supported: fake, openai, anthropic, google. Production must not use fake.
EBRAG_LLM__PROVIDER=fake
EBRAG_LLM__API_KEY=
EBRAG_LLM__MODEL=gpt-4o-mini
EBRAG_LLM__BASE_URL=https://api.openai.com/v1
EBRAG_LLM__TIMEOUT_SECONDS=60
EBRAG_LLM__MAX_RETRIES=2

# Supported: fake, sentence_transformers. Production must not use fake.
EBRAG_EMBEDDING__PROVIDER=fake
EBRAG_EMBEDDING__MODEL=BAAI/bge-small-en-v1.5
EBRAG_VECTOR__COLLECTION=evidence_spans
EBRAG_RERANKER__PROVIDER=simple

EBRAG_STORAGE__OBJECT_STORE=minio
EBRAG_STORAGE__RAW_BUCKET=raw-documents
EBRAG_STORAGE__PARSED_BUCKET=parsed-documents
EBRAG_STORAGE__PAGE_IMAGE_BUCKET=page-images
EBRAG_STORAGE__MINIO_ACCESS_KEY=ebrag_minio
EBRAG_STORAGE__MINIO_SECRET_KEY=replace-with-strong-minio-secret
EBRAG_STORAGE__MINIO_SECURE=false
EBRAG_STORAGE__LOCAL_ROOT=.local-object-store

EBRAG_SERVICES__OPENSEARCH_URL=http://localhost:9200
EBRAG_SERVICES__QDRANT_URL=http://localhost:6333
EBRAG_SERVICES__NEO4J_URL=bolt://localhost:7687
EBRAG_SERVICES__MINIO_ENDPOINT=localhost:9000
EBRAG_SERVICES__REDIS_URL=redis://localhost:6379/0
EBRAG_SERVICES__GROBID_URL=http://localhost:8070
